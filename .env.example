# Copy to ".env" (docker compose and Visual Studio read it automatically). NEVER commit .env.
# SQL Server requires a complex password (8+ chars, upper, lower, digit, symbol). Avoid ; = ' " $ in values.
MSSQL_SA_PASSWORD=ChangeMe-Str0ng-Passw0rd
POSTGRES_PASSWORD=ChangeMe-pg-Passw0rd
# Shared secret between internal services for payment write endpoints
INTERNAL_API_KEY=change-me-internal-key

# Payment simulator: Rules | AlwaysSucceed | AlwaysFail | Random   (Rules: e-mail containing "fail" is declined)
PAYMENT_GATEWAY_MODE=Rules
PAYMENT_GATEWAY_DELAY_MS=1500

# --- AWS ---
# Local Docker: leave AWS_SERVICE_URL pointing at LocalStack. For real AWS set it EMPTY and use IAM roles
# (no access keys in config). Region applies to both.
AWS_REGION=us-east-1
AWS_SERVICE_URL=http://localstack:4566
AWS_AUTO_PROVISION=true
