{
  "Logging": { "LogLevel": { "Default": "Information", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ] },
  "ReverseProxy": {
    "Routes": {
      "products": { "ClusterId": "orders", "Match": { "Path": "/api/products/{**rest}" } },
      "orders":   { "ClusterId": "orders", "Match": { "Path": "/api/orders/{**rest}" } }
    },
    "Clusters": {
      "orders": { "Destinations": { "d1": { "Address": "http://localhost:5101/" } } }
    }
  }
}
